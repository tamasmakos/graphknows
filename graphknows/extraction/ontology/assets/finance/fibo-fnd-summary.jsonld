{
  "@context": {"@vocab": "https://spec.edmcouncil.org/fibo/ontology/FND/"},
  "@id": "fibo-fnd-summary",
  "classes": [
    "FinancialInstrument", "Security", "Equity", "Stock", "Bond", "Derivative",
    "Option", "Future", "Swap", "Warrant", "Note",
    "FinancialServiceProvider", "Bank", "InvestmentFirm", "Fund", "HedgeFund",
    "Market", "Exchange", "Portfolio", "Account",
    "Transaction", "Trade", "Payment", "Settlement",
    "MonetaryAmount", "Currency", "Price", "Rate", "Index",
    "FinancialContract", "Loan", "Mortgage", "LeasingContract",
    "LegalEntity", "PrivateCompany", "PublicCompany", "Subsidiary"
  ],
  "properties": [
    "isIssuedBy", "isTradedOn", "denominatedIn", "hasFaceValue",
    "hasMaturityDate", "underlies", "settlesOn", "isOwned",
    "managesPortfolio", "hasExposureTo", "hedges", "isClassifiedAs",
    "isSubsidiaryOf", "mergedWith", "acquiredBy", "operatesIn"
  ],
  "typical_relations": [
    {"subject": "Stock", "predicate": "isIssuedBy", "object": "PublicCompany"},
    {"subject": "Bond", "predicate": "isTradedOn", "object": "Exchange"},
    {"subject": "Fund", "predicate": "managesPortfolio", "object": "Portfolio"},
    {"subject": "Derivative", "predicate": "underlies", "object": "Security"},
    {"subject": "Bank", "predicate": "isSubsidiaryOf", "object": "FinancialServiceProvider"}
  ]
}
