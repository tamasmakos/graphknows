# Caddyfile — reverse proxy + HTTP Basic Auth for Memory Mirror
#
# Credentials are injected via environment variables (set in docker-compose.yaml
# or a .env file):
#   GRAPHKNOWS_AUTH_USER  — login username (e.g. "admin")
#   GRAPHKNOWS_AUTH_HASH  — bcrypt hash of the password
#
# Generate a hash:
#   docker run --rm caddy:alpine caddy hash-password --plaintext 'your-password'
#
# To enable HTTPS later, replace ":80" with your domain name (e.g. "mirror.example.com")
# and Caddy will obtain a Let's Encrypt certificate automatically.

:80 {
    basicauth /* {
        {$GRAPHKNOWS_AUTH_USER} {$GRAPHKNOWS_AUTH_HASH}
    }

    reverse_proxy web:8800
}
