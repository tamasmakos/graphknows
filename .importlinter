[importlinter]
root_package = graphknows
unmatched_ignore_imports_alerting = none

[importlinter:contract:layers]
name = Declared architecture layers
type = layers
layers =
    graphknows.mcp
    graphknows.graphgen
    graphknows.memory
    graphknows.config
ignore_imports =
    graphknows.config -> graphknows.config.health
    graphknows.config.health -> graphknows.config
