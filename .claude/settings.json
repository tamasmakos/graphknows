{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking gate bypass"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking gate config lock"
          }
        ]
      }
    ]
  }
}
