[run]
source = graphknows
relative_files = true

[report]
omit =
    # matplotlib visualization — no business logic, untestable without display
    graphknows/graphgen/pipeline/visualization/thesis_plots.py
    # LangGraph agent v3 — async LLM orchestration, integration-test only
    graphknows/graphgen/pipeline/iterative_orchestrator.py

[paths]
source =
    graphknows
    */graphknows
