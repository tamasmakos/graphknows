# Graphknows — environment configuration
# Copy to .env and fill in the required values before running `make dev`.
#
# Required (marked with [REQUIRED] — the stack will not start without these):
# Optional (marked [OPTIONAL] — sensible defaults exist):

# ── LLM / AI APIs ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=             # [REQUIRED] https://openrouter.ai — used for embeddings + LLM
GROQ_API_KEY=                   # [OPTIONAL] Groq inference (faster completions)
LLM_GROQ_API_KEY=               # [OPTIONAL] alias used by agent service
TAVILY_API=                     # [OPTIONAL] Tavily web search for agent tools

# ── LLM settings ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
EXTRACTION_MODEL=openai/gpt-4o-mini

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_HOST=172.18.0.1           # Docker bridge IP (host → container)
NEO4J_PORT=7687
NEO4J_URI=bolt://172.18.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                 # [REQUIRED] set in docker-compose.yaml → MUST match here
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474

# ── pgvector ──────────────────────────────────────────────────────────────────
PGVECTOR_HOST=172.18.0.1
PGVECTOR_PORT=5432
PGVECTOR_USER=graphknows
PGVECTOR_PASSWORD=              # [REQUIRED] set in docker-compose.yaml → MUST match here
PGVECTOR_DB=graphknows
PGVECTOR_DSN=postgresql://graphknows:CHANGEME@172.18.0.1:5432/graphknows

# ── Memgraph ──────────────────────────────────────────────────────────────────
MEMGRAPH_URI=bolt://172.18.0.1:17687
MEMGRAPH_HOST=172.18.0.1
MEMGRAPH_BOLT_PORT=17687

# ── Service URLs (internal cross-service calls) ───────────────────────────────
GRAPHGEN_URL=http://localhost:8025
HYBRIDRAG_URL=http://localhost:8025
GRAPHRAG_URL=http://localhost:8025
AGENT_URL=http://localhost:8002
SEARCH_URL=http://localhost:8040
KERNEL_API=http://localhost:8002

# ── Observability (optional) ──────────────────────────────────────────────────
LANGFUSE_BASE_URL=              # [OPTIONAL] Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SONAR_TOKEN=                    # [OPTIONAL] SonarQube CI analysis

# ── Data output directories ───────────────────────────────────────────────────
EURLEX_OUT_DIR=./output/eurlex
EP_DEBATES_OUT_DIR=./output/debates

# ── Misc ──────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                   # [OPTIONAL] GitHub API access
OPEN_ROUTER_API=                # alias for OPENROUTER_API_KEY (legacy)
KERNEL_API_KEY=                 # [OPTIONAL] internal auth token
