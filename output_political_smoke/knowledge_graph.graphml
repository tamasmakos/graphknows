    <edge source="EUROPEAN_PARLIAMENT" target="EUROPE">
      <data key="d17">CO_OCCURS_WITH</data>
      <data key="d19">CO_OCCURS_WITH</data>
      <data key="d18">entity_relation</data>
      <data key="d20">DOC_ep_2026-03-26_item003.txt_S9</data>
      <data key="d21">extraction</data>
      <data key="d22">1.0</data>
      <data key="d23">to conclude, we will not be intimidated. We will not be bullied into a bad deal. Today, we show our citizens that this European Parliament stands up for their interest and for our Europe. I urge the C</data>
    </edge>
