# Dockerfile.web — Memory Mirror web UI
# Serves the GraphKnows frontend (static SPA) + the Starlette API over ArcadeDB.
# Installs the full base package: the server ingests (GLiNER2/spaCy) and embeds
# queries (sentence-transformers), so a torch-free image is not possible.
#
# Build:  docker compose build web
# Run:    docker compose up -d web

# ─── builder stage ─────────────────────────────────────────────────────────────
FROM python:3.13-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir uv

# Copy manifests first (layer caching), then source so uv can build the package.
# README.md is required: pyproject declares `readme = "README.md"`, so the
# hatchling build backend fails ("Readme file does not exist") without it.
COPY pyproject.toml ./
COPY uv.lock* ./
COPY README.md ./
COPY graphknows/ ./graphknows/

RUN uv venv /opt/venv && \
    uv pip install --python /opt/venv/bin/python --no-cache ".[all]" && \
    uv pip install --python /opt/venv/bin/python --no-cache \
        "https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.8.0/en_core_web_lg-3.8.0-py3-none-any.whl"

# ─── runtime stage ─────────────────────────────────────────────────────────────
FROM python:3.13-slim AS runtime

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
# Static frontend files served by the Starlette app
COPY frontend/ ./frontend/

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Bind to all interfaces so Docker can route traffic to this container.
    GRAPHKNOWS_WEB_HOST="0.0.0.0" \
    GRAPHKNOWS_WEB_PORT="8800" \
    # Tell the server where to find the static files inside the image.
    GRAPHKNOWS_FRONTEND_DIR="/app/frontend"

RUN useradd -m -u 1000 graphknows
USER graphknows

EXPOSE 8800

# Timeout raised to 15s: the probe cold-starts a Python interpreter each run and
# was timing out under CPU load (endpoint itself returns 200), flapping unhealthy.
HEALTHCHECK --interval=30s --timeout=15s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8800/healthz')" || exit 1

CMD ["graphknows-web"]
